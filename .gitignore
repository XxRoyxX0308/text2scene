# Everything the pipeline produces (candidates, GLBs, bakes, engine package, shots, logs)
work/*
export/

# Blender
*.blend
*.blend1
*.blend2

# Project inputs (assets.json, layout.json) and the machine config (t2s.config.json) are per user;
# the examples are part of the repo
*.json
!/examples/*.json

# 3D models and model weights, wherever they end up
*.glb
*.gltf
*.safetensors
*.pth
*.ckpt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets
.env
*.token

# Editor / OS
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
.DS_Store

# Scene descriptions and other inputs are project-specific; keep them out of the repo
/*.md
!/README.md
!/AGENT.md
